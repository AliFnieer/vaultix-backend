# =============================================================================
# Vaultix Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit the .env file to version control.
#
# Every key below is read by internal/config/config.go unless noted.

# Application
# APP_ENV is documentation-only (used by deployment tooling, not read by the backend)
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
# Gin mode: debug | release
GIN_MODE=debug

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=vaultix
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_CONN_MAX_IDLE_MINUTES=30

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# JWT (auth) - secrets must be strong random values in production.
# TTLs are plain integers: minutes for access, hours for refresh.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=720
JWT_ISSUER=vaultix-api

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Field-level encryption for secret values (AES-256-GCM)
# Must be a base64-encoded 32-byte key. Generate with:
#   head -c 32 /dev/urandom | base64
FIELD_ENCRYPTION_KEY=