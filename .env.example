# =============================================================================
# Vaultix Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit the .env file to version control.

# Application
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
APP_READ_TIMEOUT=15s
APP_WRITE_TIMEOUT=15s
APP_IDLE_TIMEOUT=60s
APP_BASE_URL=http://localhost:8080

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json   # json | console

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=vaultix
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_CONN_MAX_IDLE_TIME=30s

# JWT (auth)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Password hashing (bcrypt cost)
BCRYPT_COST=12

# Field-level encryption for secret values (AES-256-GCM)
# Must be a base64-encoded 32-byte key. Generate with:
#   head -c 32 /dev/urandom | base64
FIELD_ENCRYPTION_KEY=change-me-base64-32-byte-key-==

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173